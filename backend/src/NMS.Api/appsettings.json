{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "Database": { "MigrateOnStartup": false },
  "Jwt": { "Issuer": "nms-api", "Audience": "nms-clients" },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshReuseGraceSeconds": 10,
    "MinPasswordLength": 12
  },
  "Attendance": { "TimeZoneId": "Asia/Dubai", "LateGraceMinutes": 15, "EarlyLeaveGraceMinutes": 15 },
  "Jobs": { "Enabled": true, "IntervalMinutes": 15 },
  "RateLimiting": { "AuthenticatedPerMinute": 100, "AnonymousPerMinute": 10, "LoginPerMinute": 5, "SessionPerMinute": 60 }
}
