{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "Database": { "MigrateOnStartup": false },
  "Jwt": { "Issuer": "nms-api", "Audience": "nms-clients" },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "MinPasswordLength": 12
  },
  "RateLimiting": { "AuthenticatedPerMinute": 100, "AnonymousPerMinute": 10, "LoginPerMinute": 5 }
}
